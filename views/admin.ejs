<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Admin Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>

<body class="bg-zinc-900 text-white flex items-center justify-center min-h-screen">

  <!-- WARNING BOX -->
  <div id="warningBox" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center">

    <div class="bg-zinc-800 text-white p-8 rounded-xl w-96 text-center space-y-4 shadow-xl">
      <h2 class="text-xl font-semibold text-red-500">🚨Restricted Area!</h2>

      <p class="text-zinc-300">
        This panel is for authorized for administrators only. <br> If you do not have permission, kindly close this
        page.
      </p>

      <div class="flex justify-center gap-4 mt-4">
        <button onclick="document.getElementById('warningBox').classList.add('hidden')"
          class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded">
          I'm an Admin
        </button>

        <a href="/" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded inline-block text-center">
          Go Back
        </a>
      </div>
    </div>

  </div>

  <!-- LOGIN -->
  <div id="loginScreen" class="bg-zinc-800 p-8 rounded-xl shadow-lg w-80 space-y-4">
    <h2 class="text-2xl font-semibold text-center">Admin Login</h2>

    <input type="password" id="adminPassword" placeholder="Enter Password"
      class="w-full p-2 rounded bg-zinc-700 border border-zinc-600 focus:outline-none focus:ring-2 focus:ring-blue-500">

    <button onclick="checkPassword()"
      class="w-full bg-blue-600 hover:bg-blue-700 transition duration-200 p-2 rounded font-medium">
      Login
    </button>

    <p id="loginError" class="text-red-500 text-sm text-center"></p>
  </div>

  <!-- DASHBOARD -->
  <div id="dashboard" class="rounded-xl shadow-lg hidden min-h-screen bg-zinc-900 text-white">
  
    <!-- NAVBAR -->
    <div class=" w-screen flex justify-between items-center bg-zinc-800 px-6 py-4 shadow-md">
  
      <h1 class="text-xl font-semibold">
        Admin Dashboard 📊
      </h1>
  
      <button onclick="window.location.href='/'" class="bg-red-600 hover:bg-red-700 transition px-4 py-2 rounded-lg">
        Logout
      </button>
  
    </div>
  
    <!-- CONTENT AREA -->
    <div class="p-6">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-left text-gray-300">
    
          <thead class="bg-zinc-700 text-gray-200 uppercase text-xs">
            <tr>
              <th class="px-6 py-3">Date & Time</th>
              <th class="px-6 py-3">Him</th>
              <th class="px-6 py-3">Her</th>
              <th class="px-6 py-3 text-center">Score</th>
              <th class="px-6 py-3 text-center">Action</th>
            </tr>
          </thead>
    
          <tbody id="tableBody" class="bg-zinc-800 divide-y divide-zinc-700"></tbody>
    
        </table>
      </div>
    </div>

  
  </div>


  <script src="/javascripts/admin.js"></script>
</body>

</html>